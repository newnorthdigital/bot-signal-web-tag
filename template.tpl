___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const logToConsole = require('logToConsole');

// Pinned release of bot-signal.js in this repo, served by jsDelivr. Bump the
// tag here (and in the inject_script permission) when the script changes.
const SCRIPT_URL = 'https://cdn.jsdelivr.net/gh/newnorthdigital/bot-signal-web-tag@1.0.0/bot-signal.js';

const debugLog = (msg) => { if (data.debug) logToConsole('NND Bot Signal - ' + msg); };

let hasFired = false;
const fire = () => {
  if (hasFired) { return; }
  hasFired = true;
  injectScript(SCRIPT_URL, () => {
    debugLog('bot-signal.js loaded');
    data.gtmOnSuccess();
  }, () => {
    debugLog('bot-signal.js failed to load');
    data.gtmOnFailure();
  }, 'nnd-bot-signal');
};

const consentMode = data.consentMode || 'auto';
if (consentMode === 'off' || isConsentGranted('analytics_storage')) {
  fire();
} else {
  debugLog('Waiting for analytics_storage consent');
  addConsentListener('analytics_storage', (consentType, granted) => { if (granted) { fire(); } });
}


